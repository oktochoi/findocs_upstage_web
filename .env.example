# 실제 API 키는 .env.local에 입력
UPSTAGE_API_KEY=

# 실행할 워크플로우
UPSTAGE_AGENT_ID=agt_6VePZ2RfnDVzbBTDh4XFka

# Studio 설정 버전. API 요청에서는 문자열 "3"으로 전달
UPSTAGE_CONFIG_ID=3

# 모든 Upstage 요청의 x-project-id 헤더에 사용
UPSTAGE_PROJECT_ID=proj_jrT59u4odFMYBD83EyShHp

# API 기본 주소
UPSTAGE_BASE_URL=https://api.upstage.ai/v2
